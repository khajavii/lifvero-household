{
  "name": "lifvero-household",
  "version": "1.0.0",
  "description": "nest household project",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migration:create": "typeorm migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:show": "node -r ts-node/register ./node_modules/typeorm/cli.js migration:show -d ./src/data-source.ts",
    "migration:run": "node -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:revert": "node -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/data-source.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khajavii/lifvero-household.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/khajavii/lifvero-household/issues"
  },
  "homepage": "https://github.com/khajavii/lifvero-household#readme",
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "joi": "^18.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.5.2",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20"
  }
}
